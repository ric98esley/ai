<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ai_mcp.model_permission View List -->
    <record id="view_ai_mcp_model_permission_list" model="ir.ui.view">
        <field name="name">view.ai_mcp.model_permission.list</field>
        <field name="model">ai_mcp.model_permission</field>
        <field name="arch" type="xml">
            <list string="Ai mcp Model permission" create="true" editable="bottom">
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
                <field name="perm_create"/>
                <field name="perm_unlink"/>
            </list>
        </field>
    </record>

    <!-- View ai_mcp.model_permission form -->
    <record id="view_ai_mcp_model_permission_form" model="ir.ui.view">
        <field name="name">view.ai_mcp.model_permission.form</field>
        <field name="model">ai_mcp.model_permission</field>
        <field name="arch" type="xml">
            <form string="Ai_mcp Model_permission">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="model_id"/>
                        <field name="model_name"/>
                        <field name="perm_read"/>
                        <field name="perm_write"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View ai_mcp.model_permission search -->
    <record id="view_ai_mcp_model_permission_search" model="ir.ui.view">
        <field name="name">view.ai_mcp.model_permission.search</field>
        <field name="model">ai_mcp.model_permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
            </search>
        </field>
    </record>

    <!-- Action ai_mcp.model_permission -->
    <record id="action_ai_mcp_model_permission" model="ir.actions.act_window">
        <field name="name">Ai_mcp Model_permission</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ai_mcp.model_permission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Ai_mcp Model_permission.
            </p>
        </field>
    </record>

</odoo>
